# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Read ONLY by this project (python-dotenv, loaded into the app process);
# never set as user/system environment variables.

APP_NAME=AI Skin Disease Detection
BRAND_NAME=DermaCareAI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
SECRET_KEY=change-me

# MySQL (existing local server). scripts/db_setup.ps1 creates both users and fills the passwords.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skin_ai_db
DB_USER=skin_ai_app
DB_PASSWORD=
DB_MIGRATE_USER=skin_ai_migrate
DB_MIGRATE_PASSWORD=

# Uploads / ML
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_MB=8
MIN_IMAGE_SIDE=224
MODEL_DIR=ml/artifacts
CONFIDENCE_THRESHOLD=0.50
INCONCLUSIVE_MARGIN=0.10
ENABLE_GRADCAM=true

# Privacy
RETENTION_DAYS=30
