# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Read ONLY by this project (python-dotenv, loaded into the app process);
# never set as user/system environment variables.

APP_NAME=AI Skin Disease Detection
BRAND_NAME=DermaCareAI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
SECRET_KEY=change-me

# MySQL (existing local server). scripts/db_setup.ps1 creates both users and fills the passwords.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skin_ai_db
DB_USER=skin_ai_app
DB_PASSWORD=
DB_MIGRATE_USER=skin_ai_migrate
DB_MIGRATE_PASSWORD=

# Uploads / ML
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_MB=8
MIN_IMAGE_SIDE=224
MODEL_DIR=ml/artifacts
CONFIDENCE_THRESHOLD=0.50
INCONCLUSIVE_MARGIN=0.10
ENABLE_GRADCAM=true

# Privacy
RETENTION_DAYS=30

# Optional: email for password-reset links. Leave MAIL_SERVER empty to use admin-issued links only.
# Example (Gmail): MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
# MAIL_PASSWORD=<an App Password, not your normal password>, MAIL_FROM=you@gmail.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional: "Continue with Google". Create an OAuth Client ID (Web application) in Google Cloud Console,
# add the redirect URI http://127.0.0.1:8010/auth/google/callback, then paste both values here.
# Leave both empty to hide the Google button. See docs/GOOGLE_SIGNIN.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Roboflow API key, only needed to download the training photo sets (python -m ml.src.roboflow_download).
# Get yours at app.roboflow.com -> Settings -> API Keys. Keep it private; .env is never committed.
ROBOFLOW_API_KEY=

# Optional Google Places API key for "Find a dermatologist" (more clinics and phone numbers).
# Leave empty to use free OpenStreetMap data. See docs/FIND_A_DERMATOLOGIST.md.
GOOGLE_MAPS_API_KEY=
